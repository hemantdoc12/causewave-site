---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-slate-900 text-slate-400 text-xs">
  <div class="max-w-screen-2xl mx-auto px-8 pt-8 pb-6">
    <div class="grid md:grid-cols-12 gap-y-6">
      <div class="md:col-span-6">
        <div class="flex items-center gap-x-2 mb-3">
          <img src={`${base}logo_2.png`} alt="Causewave" class="h-7 w-auto">
          <span class="text-lg text-white font-semibold tracking-tighter">Causewave</span>
        </div>
        <div class="max-w-xs text-slate-400 text-xs">
          Causewave Innovations LLP<br>
          Ahmedabad, Gujarat, India<br>
          <a href="mailto:info@causewaveinnovations.com" class="hover:text-white">info@causewaveinnovations.com</a><br>
          <a href="tel:+917600596053" class="hover:text-white">+91 76005 96053</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-2 text-xs tracking-widest">COMPANY</div>
        <div class="space-y-1.5 text-xs">
          <a href={`${base}about`} class="block hover:text-white">About Us</a>
          <a href={`${base}about`} class="block hover:text-white">Leadership</a>
          <a href={`${base}insights`} class="block hover:text-white">Insights</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-2 text-xs tracking-widest">LEGAL</div>
        <div class="space-y-1.5 text-xs">
          <a href="#" class="block hover:text-white">Privacy Policy</a>
          <a href="#" class="block hover:text-white">Terms of Service</a>
        </div>
      </div>
    </div>

    <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center text-xs">
      <div>&copy; {new Date().getFullYear()} Causewave Innovations LLP. All rights reserved.</div>
      <div class="mt-2 md:mt-0">
        <span>Made with purpose in India</span>
      </div>
    </div>
  </div>
</footer>
