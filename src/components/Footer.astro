---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-slate-900 text-slate-400 text-sm">
  <div class="max-w-screen-2xl mx-auto px-8 pt-16 pb-12">
    <div class="grid md:grid-cols-12 gap-y-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-x-3 mb-6">
          <img src={`${base}logo_2.png`} alt="Causewave" class="h-9 w-auto">
          <span class="font-display text-2xl text-white font-semibold tracking-tighter">Causewave</span>
        </div>
        <div class="max-w-xs text-slate-400">
          Causewave Innovations LLP<br>
          Ahmedabad, Gujarat, India<br>
          <a href="mailto:hello@causewave.co.in" class="hover:text-white">hello@causewave.co.in</a>
        </div>

        <div class="flex gap-x-5 mt-8">
          <a href="#" class="hover:text-white" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in text-xl"></i></a>
          <a href="#" class="hover:text-white" aria-label="Twitter"><i class="fa-brands fa-twitter text-xl"></i></a>
          <a href="#" class="hover:text-white" aria-label="Instagram"><i class="fa-brands fa-instagram text-xl"></i></a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-4 text-xs tracking-widest">COMPANY</div>
        <div class="space-y-2.5 text-sm">
          <a href={`${base}about`} class="block hover:text-white">About Us</a>
          <a href={`${base}about`} class="block hover:text-white">Leadership</a>
          <a href={`${base}insights`} class="block hover:text-white">Insights</a>
        </div>
      </div>

      <div class="md:col-span-3">
        <div class="font-semibold text-white mb-4 text-xs tracking-widest">INSIGHTS</div>
        <div class="space-y-2.5 text-sm">
          <a href={`${base}insights`} class="block hover:text-white">All Articles</a>
          <a href={`${base}insights`} class="block hover:text-white">Healthcare Innovation</a>
          <a href={`${base}insights`} class="block hover:text-white">CSR Strategy</a>
          <a href={`${base}insights`} class="block hover:text-white">Technology Solutions</a>
        </div>
      </div>

      <div class="md:col-span-4">
        <div class="font-semibold text-white mb-4 text-xs tracking-widest">LEGAL & MORE</div>
        <div class="space-y-2.5 text-sm">
          <a href="#" class="block hover:text-white">Privacy Policy</a>
          <a href="#" class="block hover:text-white">Terms of Service</a>
          <a href="https://github.com/hemantdoc12/causewave-site" target="_blank" class="block hover:text-white flex items-center gap-x-1">View Source on GitHub <i class="fa-brands fa-github text-xs"></i></a>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center text-xs">
      <div>&copy; {new Date().getFullYear()} Causewave Innovations LLP. All rights reserved.</div>
      <div class="mt-3 md:mt-0 flex items-center gap-x-2">
        <span>Designed for impact.</span>
        <span class="text-emerald-500">&bull;</span>
        <span>Made with purpose in India</span>
      </div>
    </div>
  </div>
</footer>
