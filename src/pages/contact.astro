---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Causewave Innovations LLP"
  description="Ready to build CSR programs that deliver real results? Contact Causewave for strategy, implementation, and impact reporting support. We respond within 24 hours."
  ogTitle="Contact Causewave | CSR Consulting"
  ogDescription="Let's discuss how we can help you build compliant, measurable, and community-trusted CSR programs."
  canonicalPath="/contact"
  activePage="contact"
>
  <div class="max-w-2xl mx-auto px-8 py-20">
    <h1 class="text-6xl font-semibold tracking-tight">Ready to build CSR programs that deliver real results?</h1>
    <p class="mt-6 text-xl text-slate-600">Whether you're planning your first CSR initiative or looking to strengthen existing programs, our team is here to help.</p>

    <form class="mt-12 space-y-6" action="https://formspree.io/f/PLACEHOLDER" method="POST">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-600 mb-2">Your Name</label>
          <input type="text" id="name" name="name" required class="w-full border border-slate-200 rounded-2xl px-5 py-3.5" placeholder="Priya Sharma">
        </div>
        <div>
          <label for="company" class="block text-sm font-medium text-slate-600 mb-2">Company</label>
          <input type="text" id="company" name="company" class="w-full border border-slate-200 rounded-2xl px-5 py-3.5" placeholder="Tata Consumer Products">
        </div>
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-slate-600 mb-2">Work Email</label>
        <input type="email" id="email" name="email" required class="w-full border border-slate-200 rounded-2xl px-5 py-3.5" placeholder="you@company.com">
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-slate-600 mb-2">Tell us about your project</label>
        <textarea id="message" name="message" rows="6" required class="w-full border border-slate-200 rounded-3xl px-5 py-4" placeholder="We're looking to measure the impact of our education initiative across 5 states..."></textarea>
      </div>
      <button type="submit" class="w-full py-4 bg-gradient-to-r from-sky-500 to-teal-500 text-white font-semibold rounded-3xl hover:shadow-lg hover:shadow-sky-500/25 transition-all">Send Message</button>
      <p class="text-sm text-slate-500 text-center">We typically respond within 24 hours.</p>
    </form>
  </div>

  <!-- Contact Info -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-16">
      <div class="grid md:grid-cols-3 gap-12 text-center">
        <div>
          <div class="w-16 h-16 bg-sky-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-envelope text-2xl text-sky-600"></i>
          </div>
          <h4 class="text-xl font-semibold mb-2">Email</h4>
          <a href="mailto:hello@causewave.co.in" class="text-slate-600 hover:text-sky-600">hello@causewave.co.in</a>
        </div>
        <div>
          <div class="w-16 h-16 bg-teal-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-location-dot text-2xl text-teal-600"></i>
          </div>
          <h4 class="text-xl font-semibold mb-2">Location</h4>
          <p class="text-slate-600">Ahmedabad, Gujarat, India</p>
        </div>
        <div>
          <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fa-solid fa-clock text-2xl text-emerald-600"></i>
          </div>
          <h4 class="text-xl font-semibold mb-2">Response Time</h4>
          <p class="text-slate-600">Within 24 hours</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
