---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Causewave Innovations LLP | CSR Strategy • Implementation • Impact</title>
  <link rel="stylesheet" href="/src/styles/global.css">
</head>
<body class="bg-slate-50 text-slate-800">
  <!-- Navbar -->
  <nav class="bg-white border-b border-slate-100 sticky top-0 z-50">
    <div class="max-w-screen-2xl mx-auto px-8 py-5 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <img src="/logo_2.png" alt="Causewave" class="h-11 w-auto">
      </div>
      <div class="hidden md:flex items-center gap-x-9 text-sm font-medium">
        <a href="#services" class="hover:text-sky-600">Services</a>
        <a href="#about" class="hover:text-sky-600">About</a>
        <a href="#leadership" class="hover:text-sky-600">Leadership</a>
        <a href="#impact" class="hover:text-sky-600">Impact</a>
      </div>
      <div class="flex items-center gap-x-4">
        <a href="#contact" class="px-6 py-2.5 border border-slate-300 rounded-3xl text-sm font-semibold hover:bg-slate-100">Talk to us</a>
        <a href="#contact" class="px-5 py-2.5 bg-slate-900 text-white rounded-3xl text-sm font-semibold">Get Started</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header class="bg-slate-900 text-white pt-20 pb-24">
    <div class="max-w-screen-2xl mx-auto px-8 grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-7">
        <h1 class="text-6xl md:text-7xl font-semibold tracking-tighter leading-tight mb-6">
          We help companies deliver CSR programs that are<br>
          <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">compliant, measurable, and genuinely trusted by communities</span>
        </h1>
        <p class="max-w-lg text-xl text-slate-300 mb-10">
          Backed by 18+ years of public health leadership and last-mile delivery expertise, we turn good intentions into real, measurable impact.
        </p>
        <div class="flex gap-4">
          <a href="#services" class="px-8 py-4 bg-white text-slate-900 rounded-3xl font-semibold">Explore Services</a>
          <a href="#contact" class="px-8 py-4 border border-white/40 rounded-3xl font-semibold">Book a Strategy Call</a>
        </div>
      </div>
      <div class="md:col-span-5 flex justify-center">
        <div class="bg-white/95 p-8 rounded-[3.5rem] shadow-2xl">
          <img src="/logo_1.png" alt="Causewave" class="w-[260px] mx-auto">
        </div>
      </div>
    </div>
  </header>

  <!-- Services Section -->
  <section id="services" class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="text-center mb-16">
      <span class="text-sky-600 font-semibold">WHAT WE DELIVER</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4">CSR support across the full program cycle</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- Service Cards -->
      <div class="bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all cursor-pointer" onclick="showModal(0)">
        <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-handshake text-3xl text-sky-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">CSR Strategy & Compliance</h3>
        <p class="text-slate-600">Shape CSR priorities, annual action plans, partner alignment, and reporting readiness around clear statutory and board expectations.</p>
      </div>

      <div class="bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all cursor-pointer" onclick="showModal(1)">
        <div class="w-14 h-14 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-sitemap text-3xl text-teal-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">Program Design & Budgeting</h3>
        <p class="text-slate-600">Design practical CSR initiatives across health, education, livelihoods, sustainability, and community development with measurable outputs.</p>
      </div>

      <!-- Add remaining cards -->
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-slate-900 text-white py-16">
    <div class="max-w-screen-2xl mx-auto px-8 text-center">
      <p>© 2026 Causewave Innovations LLP. All rights reserved.</p>
    </div>
  </footer>

  <script>
    function showModal(index) {
      alert('Modal will open here with full service details.');
    }
  </script>
</body>
</html>