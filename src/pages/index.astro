---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Causewave Innovations LLP | CSR Strategy, Implementation & Impact"
  description="Causewave helps companies deliver compliant, measurable, and community-trusted CSR programs. Backed by 18+ years of public health leadership and last-mile expertise across India."
  ogTitle="Causewave Innovations LLP | CSR Strategy & Impact"
  ogDescription="We help companies build CSR programs that are compliant, measurable, and genuinely trusted by communities."
  canonicalPath="/"
  activePage="home"
>
  <!-- Hero -->
  <header class="hero-bg text-white pt-20 pb-24">
    <div class="max-w-screen-2xl mx-auto px-8 grid md:grid-cols-12 gap-12 items-center relative z-10">
      <div class="md:col-span-7">
        <h1 class="text-4xl sm:text-5xl md:text-5xl lg:text-6xl font-semibold tracking-tighter leading-tight mb-6">
          CSR Programs That <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">Actually Work</span>
        </h1>
        <p class="max-w-lg text-xl text-slate-300 mb-10">
          From strategy to community impact — we build programs that satisfy boards, regulators, and the people they serve.
        </p>
        <div class="flex gap-4">
          <a href={`${base}services`} class="px-8 py-4 bg-white text-slate-900 rounded-3xl font-semibold">Explore Services</a>
          <a href={`${base}contact`} class="px-8 py-4 border border-white/40 rounded-3xl font-semibold">Book a Strategy Call</a>
        </div>
      </div>
      <div class="md:col-span-5 flex justify-center">
        <img src={`${base}logo_1.png`} alt="Causewave" class="w-[320px] hero-logo">
      </div>
    </div>
  </header>

  <!-- Services Section -->
  <section id="services" class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="text-center mb-16">
      <span class="text-sky-600 font-semibold">WHAT WE DELIVER</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4">CSR support across the full program cycle</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <a href={`${base}services`} class="service-card bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all block">
        <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-handshake text-3xl text-sky-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">CSR Strategy & Compliance</h3>
        <p class="text-slate-600">Shape CSR priorities, annual action plans, partner alignment, and reporting readiness around clear statutory and board expectations.</p>
      </a>

      <a href={`${base}services`} class="service-card bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all block">
        <div class="w-14 h-14 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-sitemap text-3xl text-teal-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">Program Design & Budgeting</h3>
        <p class="text-slate-600">Design practical CSR initiatives across health, education, livelihoods, sustainability, and community development with measurable outputs.</p>
      </a>

      <a href={`${base}services`} class="service-card bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all block">
        <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-chart-line text-3xl text-emerald-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">Impact Measurement & Reporting</h3>
        <p class="text-slate-600">Build credible M&E frameworks, collect field data, and produce board-ready impact reports that satisfy regulators and stakeholders.</p>
      </a>
    </div>

    <div class="text-center mt-12">
      <a href={`${base}services`} class="inline-flex px-8 py-4 bg-slate-900 text-white rounded-3xl font-semibold hover:bg-sky-600 transition-all">
        View All Services <i class="fa-solid fa-arrow-right ml-2"></i>
      </a>
    </div>
  </section>

  <!-- About Preview -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-20 grid md:grid-cols-2 gap-16 items-center">
      <div>
        <span class="text-sky-600 font-semibold">WHO WE ARE</span>
        <h2 class="text-5xl font-semibold tracking-tight mt-4 mb-6">Bridging CSR compliance and real community impact</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-6">
          Most CSR programs struggle to be both compliant and truly impactful. Causewave exists to close that gap — with 18+ years of public health leadership and field expertise across India.
        </p>
        <a href={`${base}about`} class="inline-flex px-6 py-3 border border-slate-300 rounded-3xl font-semibold hover:bg-slate-100 transition-all">
          Learn More About Us <i class="fa-solid fa-arrow-right ml-2"></i>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-6">
        <div class="bg-slate-50 p-8 rounded-3xl text-center">
          <div class="text-4xl font-bold text-sky-600 mb-2">18+</div>
          <div class="text-slate-600 font-medium">Years of Public Health Leadership</div>
        </div>
        <div class="bg-slate-50 p-8 rounded-3xl text-center">
          <div class="text-4xl font-bold text-teal-600 mb-2">33L+</div>
          <div class="text-slate-600 font-medium">Vaccination Doses in a Single Day</div>
        </div>
        <div class="bg-slate-50 p-8 rounded-3xl text-center">
          <div class="text-4xl font-bold text-emerald-600 mb-2">5+</div>
          <div class="text-slate-600 font-medium">States Across India</div>
        </div>
        <div class="bg-slate-50 p-8 rounded-3xl text-center">
          <div class="text-4xl font-bold text-sky-600 mb-2">SKOCH</div>
          <div class="text-slate-600 font-medium">Gold Award Winner</div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
