<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Causewave Innovations LLP | CSR Strategy, Implementation & Impact</title>
  <meta name="description" content="Causewave helps companies deliver compliant, measurable, and community-trusted CSR programs. Backed by 18+ years of public health leadership and last-mile expertise across India.">
  
  <meta property="og:title" content="Causewave Innovations LLP | CSR Strategy & Impact">
  <meta property="og:description" content="We help companies build CSR programs that are compliant, measurable, and genuinely trusted by communities.">
  <meta property="og:image" content="https://hemantdoc12.github.io/causewave-site/logo_1.png">
  <meta property="og:url" content="https://hemantdoc12.github.io/causewave-site/">
  <meta property="og:type" content="website">
  
  <link rel="canonical" href="https://hemantdoc12.github.io/causewave-site/">
  <link rel="stylesheet" href="/src/styles/global.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .logo-image { transition: transform 0.3s ease; }
    .logo-image:hover { transform: scale(1.05); }
    .service-card { box-shadow: 0 4px 6px -1px rgb(15 23 42 / 0.1), 0 2px 4px -2px rgb(15 23 42 / 0.1); }
    .service-card:hover { box-shadow: 0 20px 25px -5px rgb(15 23 42 / 0.1), 0 8px 10px -6px rgb(15 23 42 / 0.1); }
  </style>
</head>
<body class="bg-slate-50 text-slate-800">
  <!-- Navbar -->
  <nav class="bg-white border-b border-slate-100 sticky top-0 z-50">
    <div class="max-w-screen-2xl mx-auto px-8 py-5 flex items-center justify-between">
      <div class="flex items-center gap-x-3">
        <img src="/logo_2.png" alt="Causewave" class="h-12 w-auto logo-image">
      </div>

      <div class="hidden md:flex items-center gap-x-9 text-sm font-medium">
        <a href="#services" class="hover:text-sky-600">Services</a>
        <a href="#about" class="hover:text-sky-600">About</a>
        <a href="#leadership" class="hover:text-sky-600">Leadership</a>
        <a href="#impact" class="hover:text-sky-600">Impact</a>
      </div>

      <div class="flex items-center gap-x-4">
        <a href="#contact" class="hidden md:inline-flex px-6 py-2.5 border border-slate-300 rounded-3xl text-sm font-semibold hover:bg-slate-100">Talk to us</a>
        <a href="#contact" class="px-5 py-2.5 bg-slate-900 text-white rounded-3xl text-sm font-semibold">Get Started</a>

        <button id="mobile-menu-btn" class="md:hidden w-10 h-10 flex items-center justify-center text-slate-600">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t bg-white px-8 py-6">
      <div class="flex flex-col gap-y-4 text-sm font-medium">
        <a href="#services" class="py-2 text-slate-600">Services</a>
        <a href="#about" class="py-2 text-slate-600">About Us</a>
        <a href="#leadership" class="py-2 text-slate-600">Leadership</a>
        <a href="#impact" class="py-2 text-slate-600">Impact</a>
        <div class="pt-4 border-t flex flex-col gap-y-3">
          <a href="#contact" class="py-3 text-center border border-slate-300 rounded-3xl font-semibold">Talk to our team</a>
          <a href="#contact" class="py-3 text-center bg-slate-900 text-white rounded-3xl font-semibold">Start a Project</a>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header class="bg-slate-900 text-white pt-20 pb-24">
    <div class="max-w-screen-2xl mx-auto px-8 grid md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-7">
        <h1 class="text-6xl md:text-7xl font-semibold tracking-tighter leading-tight mb-6">
          We help companies deliver CSR programs that are<br>
          <span class="bg-gradient-to-r from-sky-400 to-emerald-400 bg-clip-text text-transparent">compliant, measurable, and genuinely trusted by communities</span>
        </h1>
        <p class="max-w-lg text-xl text-slate-300 mb-10">
          Backed by 18+ years of public health leadership and last-mile delivery expertise, we turn good intentions into real, measurable impact.
        </p>
        <div class="flex gap-4">
          <a href="#services" class="px-8 py-4 bg-white text-slate-900 rounded-3xl font-semibold">Explore Services</a>
          <a href="#contact" class="px-8 py-4 border border-white/40 rounded-3xl font-semibold">Book a Strategy Call</a>
        </div>
      </div>
      <div class="md:col-span-5 flex justify-center">
        <div class="bg-white/95 p-8 rounded-[3.5rem] shadow-2xl">
          <img src="/logo_1.png" alt="Causewave" class="w-[280px] mx-auto">
        </div>
      </div>
    </div>
  </header>

  <!-- Services Section -->
  <section id="services" class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="text-center mb-16">
      <span class="text-sky-600 font-semibold">WHAT WE DELIVER</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4">CSR support across the full program cycle</h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="service-card bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all cursor-pointer" onclick="showModal(0)">
        <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-handshake text-3xl text-sky-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">CSR Strategy & Compliance</h3>
        <p class="text-slate-600">Shape CSR priorities, annual action plans, partner alignment, and reporting readiness around clear statutory and board expectations.</p>
      </div>

      <div class="service-card bg-white border p-8 rounded-3xl hover:-translate-y-1 transition-all cursor-pointer" onclick="showModal(1)">
        <div class="w-14 h-14 bg-teal-100 rounded-2xl flex items-center justify-center mb-6"><i class="fa-solid fa-sitemap text-3xl text-teal-600"></i></div>
        <h3 class="text-2xl font-semibold mb-3">Program Design & Budgeting</h3>
        <p class="text-slate-600">Design practical CSR initiatives across health, education, livelihoods, sustainability, and community development with measurable outputs.</p>
      </div>

      <!-- Add remaining cards -->
    </div>
  </section>

  <!-- Professional Footer -->
  <footer class="bg-slate-900 text-slate-400 text-sm">
    <div class="max-w-screen-2xl mx-auto px-8 pt-16 pb-12">
      <div class="grid md:grid-cols-12 gap-y-12">
        <div class="md:col-span-5">
          <div class="flex items-center gap-x-3 mb-6">
            <img src="/logo_2.png" alt="Causewave" class="h-9 w-auto">
            <span class="font-display text-2xl text-white font-semibold tracking-tighter">Causewave</span>
          </div>
          <div class="max-w-xs text-slate-400">
            Causewave Innovations LLP<br>
            Ahmedabad, Gujarat, India<br>
            <a href="mailto:hello@causewave.co.in" class="hover:text-white">hello@causewave.co.in</a>
          </div>

          <div class="flex gap-x-5 mt-8">
            <a href="#" class="hover:text-white"><i class="fa-brands fa-linkedin-in text-xl"></i></a>
            <a href="#" class="hover:text-white"><i class="fa-brands fa-twitter text-xl"></i></a>
            <a href="#" class="hover:text-white"><i class="fa-brands fa-instagram text-xl"></i></a>
          </div>
        </div>

        <div class="md:col-span-3">
          <div class="font-semibold text-white mb-4 text-xs tracking-widest">COMPANY</div>
          <div class="space-y-2.5 text-sm">
            <a href="#about" class="block hover:text-white">About Us</a>
            <a href="#leadership" class="block hover:text-white">Leadership</a>
            <a href="#" class="block hover:text-white">Careers</a>
          </div>
        </div>

        <div class="md:col-span-4">
          <div class="font-semibold text-white mb-4 text-xs tracking-widest">LEGAL & MORE</div>
          <div class="space-y-2.5 text-sm">
            <a href="#" class="block hover:text-white">Privacy Policy</a>
            <a href="#" class="block hover:text-white">Terms of Service</a>
            <a href="https://github.com/hemantdoc12/causewave-site" target="_blank" class="block hover:text-white flex items-center gap-x-1">View Source on GitHub <i class="fa-brands fa-github text-xs"></i></a>
          </div>
        </div>
      </div>

      <div class="mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center text-xs">
        <div>© 2026 Causewave Innovations LLP. All rights reserved.</div>
        <div class="mt-3 md:mt-0 flex items-center gap-x-2">
          <span>Designed for impact.</span>
          <span class="text-emerald-500">•</span>
          <span>Made with purpose in India</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Back to Top Button -->
  <button id="back-to-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" 
          class="hidden fixed bottom-8 right-8 w-12 h-12 bg-slate-900 text-white rounded-full shadow-lg flex items-center justify-center hover:bg-sky-600 transition-all z-50">
    <i class="fa-solid fa-arrow-up"></i>
  </button>

  <script>
    // Mobile Menu
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      mobileBtn.innerHTML = mobileMenu.classList.contains('hidden') ? 
        '<i class="fa-solid fa-bars text-xl"></i>' : 
        '<i class="fa-solid fa-times text-xl"></i>';
    });

    // Back to Top Button
    const backToTop = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 500) {
        backToTop.classList.remove('hidden');
        backToTop.classList.add('flex');
      } else {
        backToTop.classList.add('hidden');
        backToTop.classList.remove('flex');
      }
    });

    function showModal(index) {
      alert('Modal will open here with full service details.');
    }
  </script>
</body>
</html>