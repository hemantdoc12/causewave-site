---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Insights & Thought Leadership | Causewave Innovations LLP"
  description="Expert insights on CSR consulting, healthcare innovation, and technology-enabled social impact."
  ogTitle="Insights | Causewave Innovations LLP"
  ogDescription="Thought leadership on CSR strategy and healthcare delivery innovation."
  canonicalPath="/insights"
  activePage="insights"
>
  <!-- Hero -->
  <div class="page-header text-white py-10" style={`background-image: url('${base}insights-bg.jpg')`}>
    <div class="max-w-screen-2xl mx-auto px-6 relative z-10">
      <h1 class="text-3xl sm:text-4xl md:text-4xl font-semibold tracking-tight">Insights & Thought Leadership</h1>
      <p class="mt-2 text-base text-slate-300 max-w-xl">Expert perspectives on CSR innovation and healthcare delivery.</p>
    </div>
  </div>

  <!-- Featured Article -->
  <section class="max-w-screen-2xl mx-auto px-6 py-8">
    <div class="grid md:grid-cols-2 gap-6 items-center bg-gradient-to-br from-slate-50 to-white border rounded-2xl p-6 md:p-8">
      <div>
        <div class="inline-flex items-center gap-1.5 bg-amber-100 text-amber-800 px-3 py-1 rounded-full text-xs font-semibold mb-4">
          <i class="fa-solid fa-trophy"></i> SKOCH Gold Award Winner
        </div>
        <h2 class="text-2xl font-semibold tracking-tight mb-3">Innovation in Last-Mile Healthcare Delivery: The Chitta Express Model</h2>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">How we delivered 33+ lakh vaccinations to remote tribal areas using innovative mobile healthcare units.</p>
        <div class="flex flex-wrap gap-3 text-xs text-slate-500 mb-4">
          <span><i class="fa-solid fa-user mr-1"></i> Dr. Hemant L. Patel</span>
          <span><i class="fa-solid fa-clock mr-1"></i> 8 min read</span>
          <span><i class="fa-solid fa-tag mr-1"></i> Healthcare Innovation</span>
        </div>
        <a href={`${base}insights/chitta-express-innovation`} class="inline-flex px-5 py-2.5 bg-slate-900 text-white rounded-full text-sm font-semibold hover:bg-sky-600 transition-all">
          Read Full Article <i class="fa-solid fa-arrow-right ml-2"></i>
        </a>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-white border p-4 rounded-xl text-center shadow-sm">
          <div class="text-2xl font-bold text-sky-600 mb-1">33L+</div>
          <div class="text-xs text-slate-600">Vaccinations Delivered</div>
        </div>
        <div class="bg-white border p-4 rounded-xl text-center shadow-sm">
          <div class="text-2xl font-bold text-teal-600 mb-1">20</div>
          <div class="text-xs text-slate-600">Mobile Units Deployed</div>
        </div>
        <div class="bg-white border p-4 rounded-xl text-center shadow-sm">
          <div class="text-2xl font-bold text-emerald-600 mb-1">100%</div>
          <div class="text-xs text-slate-600">Remote Areas Covered</div>
        </div>
        <div class="bg-white border p-4 rounded-xl text-center shadow-sm">
          <div class="text-2xl font-bold text-sky-600 mb-1">2.4M</div>
          <div class="text-xs text-slate-600">Population Served</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">EXPLORE BY CATEGORY</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">Latest Articles</h2>
      </div>

      <!-- Category Filters -->
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        <button class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-900 text-white" data-category="all">All</button>
        <button class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-slate-200 hover:bg-slate-100" data-category="healthcare">Healthcare</button>
        <button class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-slate-200 hover:bg-slate-100" data-category="csr">CSR</button>
        <button class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-slate-200 hover:bg-slate-100" data-category="technology">Technology</button>
        <button class="filter-btn px-4 py-1.5 rounded-full text-xs font-semibold border border-slate-200 hover:bg-slate-100" data-category="leadership">Leadership</button>
      </div>

      <!-- Articles -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="technology csr">
          <div class="bg-gradient-to-br from-sky-500 to-sky-700 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">Technology & CSR</span>
            <h3 class="text-base font-semibold">Technology-Enabled CSR: Lessons from the Field</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">How digital platforms transformed our vaccination drive.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>Coming Soon</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>

        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="healthcare leadership">
          <div class="bg-gradient-to-br from-teal-500 to-teal-700 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">Community Engagement</span>
            <h3 class="text-base font-semibold">Overcoming Cultural Barriers in Health Initiatives</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">Building trust with tribal populations for real adoption.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>Coming Soon</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>

        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="csr">
          <div class="bg-gradient-to-br from-emerald-500 to-emerald-700 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">CSR Strategy</span>
            <h3 class="text-base font-semibold">Redefining CSR Resource Mapping for India's NGOs</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">How technology can unlock ₹20,000+ crore in untapped funding.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>4 min read</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>

        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="csr leadership">
          <div class="bg-gradient-to-br from-violet-500 to-violet-700 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">Development Sector</span>
            <h3 class="text-base font-semibold">A Problem Unacknowledged is a Solution Out of Reach</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">Addressing India's NGO funding crisis and FCRA changes.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>5 min read</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>

        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="technology">
          <div class="bg-gradient-to-br from-sky-600 to-indigo-600 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">AI & Innovation</span>
            <h3 class="text-base font-semibold">The Art of Sahdev: Ancient Wisdom for Modern AI Mastery</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">Strategic wisdom from Mahabharata for prompt engineering.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>6 min read</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>

        <article class="article-card bg-white border rounded-xl overflow-hidden hover:-translate-y-1 transition-all" data-category="healthcare">
          <div class="bg-gradient-to-br from-rose-500 to-rose-700 p-4 text-white">
            <span class="inline-block bg-white/20 px-2 py-0.5 rounded-full text-xs mb-2">Healthcare Policy</span>
            <h3 class="text-base font-semibold">Commentary: Family Identifier Required?</h3>
          </div>
          <div class="p-4">
            <p class="text-slate-600 text-sm mb-3">Analyzing India's health identification systems.</p>
            <div class="flex items-center gap-2 text-xs text-slate-500 mb-3">
              <span>Dr. Hemant L. Patel</span>
              <span>•</span>
              <span>3 min read</span>
            </div>
            <a href="#" class="inline-flex items-center text-sky-600 text-sm font-semibold hover:text-sky-700">
              Read More <i class="fa-solid fa-arrow-right ml-1"></i>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="bg-slate-900 text-white">
    <div class="max-w-screen-2xl mx-auto px-6 py-8 text-center">
      <h2 class="text-xl font-semibold tracking-tight mb-3">Stay Updated with Our Latest Insights</h2>
      <p class="text-sm text-slate-300 max-w-md mx-auto mb-4">Get expert perspectives delivered to your inbox.</p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input type="email" placeholder="Enter your email" required class="flex-1 px-4 py-2.5 rounded-full text-slate-900 text-sm">
        <button type="submit" class="px-6 py-2.5 bg-white text-slate-900 rounded-full text-sm font-semibold hover:bg-slate-100 transition-all">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const articles = document.querySelectorAll('.article-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-slate-900', 'text-white');
          b.classList.add('border', 'border-slate-200');
        });
        btn.classList.add('bg-slate-900', 'text-white');
        btn.classList.remove('border', 'border-slate-200');

        const category = btn.getAttribute('data-category');

        articles.forEach(article => {
          if (category === 'all' || article.getAttribute('data-category').includes(category)) {
            article.style.display = '';
          } else {
            article.style.display = 'none';
          }
        });
      });
    });
  });
</script>
