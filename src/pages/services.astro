---
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Services | Causewave Innovations LLP</title>
  <link rel="stylesheet" href="/src/styles/global.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-slate-50">
  <!-- Navbar -->
  <nav class="bg-white border-b sticky top-0 z-50">
    <div class="max-w-screen-2xl mx-auto px-8 py-5 flex justify-between items-center">
      <a href="/" class="flex items-center gap-x-3">
        <img src="/logo_2.png" alt="Causewave" class="h-10 w-auto">
      </a>
      <div class="hidden md:flex gap-x-8 text-sm font-medium">
        <a href="/" class="hover:text-sky-600">Home</a>
        <a href="/services" class="text-sky-600 font-semibold">Services</a>
        <a href="/about" class="hover:text-sky-600">About</a>
        <a href="/founder" class="hover:text-sky-600">Leadership</a>
        <a href="/contact" class="hover:text-sky-600">Contact</a>
      </div>
    </div>
  </nav>

  <!-- Header -->
  <div class="bg-slate-900 text-white py-20">
    <div class="max-w-screen-2xl mx-auto px-8 text-center">
      <h1 class="text-6xl font-semibold tracking-tight">Our Services</h1>
      <p class="mt-4 text-xl text-slate-300 max-w-2xl mx-auto">End-to-end CSR support — from strategy to impact reporting.</p>
    </div>
  </div>

  <!-- Services Grid -->
  <div class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Service Cards with Modal -->
      <div onclick="showModal(0)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-handshake text-3xl text-sky-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">CSR Strategy & Compliance</h3>
        <p class="text-slate-600">Shape CSR priorities, annual action plans, partner alignment, and reporting readiness around clear statutory and board expectations.</p>
      </div>

      <div onclick="showModal(1)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-teal-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-sitemap text-3xl text-teal-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">Program Design & Budgeting</h3>
        <p class="text-slate-600">Design practical CSR initiatives across health, education, livelihoods, sustainability, and community development with measurable outputs.</p>
      </div>

      <div onclick="showModal(2)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-map-marked text-3xl text-emerald-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">Field Implementation Support</h3>
        <p class="text-slate-600">Coordinate execution partners, milestones, beneficiary workflows, and ground-level reviews so plans become credible community outcomes.</p>
      </div>

      <div onclick="showModal(3)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-violet-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-chart-line text-3xl text-violet-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">Monitoring & Impact Reporting</h3>
        <p class="text-slate-600">Track progress, verify field evidence, and convert implementation data into concise reports for leadership, boards, and CSR committees.</p>
      </div>

      <div onclick="showModal(4)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-users text-3xl text-amber-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">Stakeholder Communication</h3>
        <p class="text-slate-600">Prepare clear updates, case stories, and partner communication that explain what changed, who benefited, and why the work matters.</p>
      </div>

      <div onclick="showModal(5)" class="service-card bg-white p-10 rounded-3xl border cursor-pointer hover:-translate-y-1 transition-all">
        <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center mb-6">
          <i class="fa-solid fa-laptop-code text-3xl text-rose-600"></i>
        </div>
        <h3 class="text-3xl font-semibold mb-4">Practical Reporting Systems</h3>
        <p class="text-slate-600">Use simple dashboards, documentation flows, and communication tools where they strengthen monitoring, reporting, and coordination.</p>
      </div>
    </div>
  </div>

  <!-- Service Modal -->
  <div id="service-modal" class="hidden fixed inset-0 bg-black bg-opacity-60 z-[9999] flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-10">
        <div class="flex justify-between items-start mb-8">
          <div id="modal-icon" class="w-16 h-16 rounded-2xl flex items-center justify-center text-4xl"></div>
          <button onclick="closeModal()" class="text-4xl text-slate-400 hover:text-slate-600">&times;</button>
        </div>
        <h2 id="modal-title" class="text-4xl font-semibold mb-6"></h2>
        <div id="modal-description" class="text-lg text-slate-600 leading-relaxed mb-8"></div>
        <div id="modal-features" class="bg-slate-50 rounded-2xl p-8"></div>
      </div>
      <div class="border-t px-10 py-6 flex justify-end">
        <button onclick="closeModal()" class="px-8 py-3 bg-slate-900 text-white rounded-3xl font-semibold">Close</button>
      </div>
    </div>
  </div>

  <script>
    const serviceData = [
      {
        icon: '<i class="fa-solid fa-handshake text-sky-600"></i>',
        title: 'CSR Strategy & Compliance',
        description: 'We help teams translate CSR intent into eligible, board-ready, and reviewable program plans that align with statutory requirements and company priorities.',
        features: ['CSR strategy and annual planning', 'Companies Act CSR compliance support', 'Policy and process review', 'Board and committee inputs', 'Partner and proposal due diligence', 'Annual CSR reporting inputs']
      },
      {
        icon: '<i class="fa-solid fa-sitemap text-teal-600"></i>',
        title: 'Program Design & Budgeting',
        description: 'We build detailed program designs across health, education, livelihoods, sustainability, and community development with clear activities, milestones, indicators, and budgets.',
        features: ['Need and context mapping', 'Activity and milestone design', 'Output and outcome indicators', 'Budget line-item structuring', 'Implementation calendar preparation']
      },
      {
        icon: '<i class="fa-solid fa-map-marked text-emerald-600"></i>',
        title: 'Field Implementation Support',
        description: 'We support the practical middle of CSR work — partner coordination, community workflows, milestones, reviews, and evidence collection during delivery.',
        features: ['Partner coordination support', 'Milestone review cadence', 'Field visit planning', 'Beneficiary workflow checks', 'Corrective action tracking']
      },
      {
        icon: '<i class="fa-solid fa-chart-line text-violet-600"></i>',
        title: 'Monitoring & Impact Reporting',
        description: 'We define indicators, review rhythm, and evidence requirements to monitor CSR implementation and convert field progress into clear reports for leadership and stakeholders.',
        features: ['Input, output, and outcome indicators', 'Review formats and scorecards', 'Progress and exception reporting', 'Evidence collection standards', 'Board-ready impact summaries']
      },
      {
        icon: '<i class="fa-solid fa-users text-amber-600"></i>',
        title: 'Stakeholder Communication',
        description: 'We prepare grounded communication that respects community context while making impact understandable to company stakeholders, partners, and leadership.',
        features: ['Impact story writing', 'Leadership update notes', 'Partner and beneficiary narratives', 'Presentation and briefing material', 'Responsible public communication guidance']
      },
      {
        icon: '<i class="fa-solid fa-laptop-code text-rose-600"></i>',
        title: 'Practical Reporting Systems',
        description: 'We use lightweight systems — dashboards, documentation flows, and communication tools — only where they improve monitoring, reporting, coordination, and communication.',
        features: ['Program dashboards', 'Evidence workflows', 'Stakeholder update formats', 'Reporting templates', 'Document management systems']
      }
    ];

    function showModal(index) {
      const data = serviceData[index];
      const modal = document.getElementById('service-modal');
      
      document.getElementById('modal-icon').innerHTML = data.icon;
      document.getElementById('modal-title').innerHTML = data.title;
      document.getElementById('modal-description').innerHTML = data.description;
      
      const featuresHTML = data.features.map(f => 
        `<div class="flex items-start gap-x-3 mb-3">
          <i class="fa-solid fa-check text-emerald-500 mt-1.5"></i>
          <span>${f}</span>
        </div>`
      ).join('');
      
      document.getElementById('modal-features').innerHTML = featuresHTML;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeModal() {
      const modal = document.getElementById('service-modal');
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    }

    // Close modal when clicking outside
    document.getElementById('service-modal').addEventListener('click', function(e) {
      if (e.target.id === 'service-modal') {
        closeModal();
      }
    });
  </script>
</body>
</html>