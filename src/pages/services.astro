---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Our Services | CSR Strategy, Implementation & Reporting | Causewave"
  description="End-to-end CSR support across strategy, program design, field implementation, monitoring, reporting, and stakeholder communication."
  ogTitle="CSR Services | Causewave Innovations LLP"
  ogDescription="We support the full CSR lifecycle — from strategy to impact reporting."
  canonicalPath="/services"
  activePage="services"
>
  <!-- Header -->
  <div class="page-header text-white py-10" style={`background-image: url('${base}services-bg.jpg')`}>
    <div class="max-w-screen-2xl mx-auto px-6 text-center relative z-10">
      <h1 class="text-3xl sm:text-4xl md:text-4xl font-semibold tracking-tight">Our Services</h1>
      <p class="mt-2 text-base text-slate-300 max-w-xl mx-auto">End-to-end CSR support — from strategy to impact reporting.</p>
    </div>
  </div>

  <!-- Services Grid -->
  <div class="max-w-screen-2xl mx-auto px-6 py-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-handshake text-xl text-sky-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">CSR Strategy & Compliance</h3>
        <p class="text-slate-600 text-sm mb-3">Shape CSR priorities, annual action plans, partner alignment, and reporting readiness.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> CSR policy & governance framework</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Annual CSR action plan</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Board & committee advisory</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Regulatory compliance audit</li>
        </ul>
      </div>

      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-sitemap text-xl text-teal-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">Program Design & Budgeting</h3>
        <p class="text-slate-600 text-sm mb-3">Design practical CSR initiatives across health, education, livelihoods, and sustainability.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Needs assessment & baseline studies</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Theory of change development</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Budget planning & optimization</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Partner selection & due diligence</li>
        </ul>
      </div>

      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-people-carry-box text-xl text-emerald-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">Field Implementation</h3>
        <p class="text-slate-600 text-sm mb-3">On-ground program execution with community mobilization and last-mile delivery.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Community engagement & mobilization</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Workforce training & capacity building</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Logistics & supply chain support</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Real-time field coordination</li>
        </ul>
      </div>

      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-magnifying-glass-chart text-xl text-sky-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">Monitoring & Evaluation</h3>
        <p class="text-slate-600 text-sm mb-3">Rigorous M&E frameworks that track outcomes and enable data-driven decisions.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Indicator design & frameworks</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Field data collection systems</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Periodic progress dashboards</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-sky-600 mt-0.5"></i> Outcome attribution analysis</li>
        </ul>
      </div>

      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-file-lines text-xl text-teal-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">Impact Reporting</h3>
        <p class="text-slate-600 text-sm mb-3">Board-ready, regulator-compliant impact reports backed by field data.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Annual CSR report preparation</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Visual impact dashboards</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Stakeholder-specific narratives</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-teal-600 mt-0.5"></i> Third-party audit support</li>
        </ul>
      </div>

      <div class="service-card bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
        <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mb-3">
          <i class="fa-solid fa-bullhorn text-xl text-emerald-600"></i>
        </div>
        <h3 class="text-lg font-semibold mb-2">Stakeholder Communication</h3>
        <p class="text-slate-600 text-sm mb-3">Compelling storytelling that builds trust and strengthens brand reputation.</p>
        <ul class="space-y-1 text-slate-600 text-xs">
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> CSR storytelling & content</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Community feedback mechanisms</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Media & PR coordination</li>
          <li class="flex items-start gap-1.5"><i class="fa-solid fa-check text-emerald-600 mt-0.5"></i> Government & NGO liaison</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Process -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">HOW WE WORK</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">Our engagement process</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-sky-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-2">1</div>
          <h4 class="text-sm font-semibold mb-1">Discover</h4>
          <p class="text-slate-600 text-xs">Understand your CSR mandate and community landscape.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-teal-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-2">2</div>
          <h4 class="text-sm font-semibold mb-1">Design</h4>
          <p class="text-slate-600 text-xs">Develop strategy with clear goals and measurable indicators.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-emerald-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-2">3</div>
          <h4 class="text-sm font-semibold mb-1">Deliver</h4>
          <p class="text-slate-600 text-xs">Execute programs with rigorous monitoring and adjustments.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-sky-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-2">4</div>
          <h4 class="text-sm font-semibold mb-1">Demonstrate</h4>
          <p class="text-slate-600 text-xs">Produce credible impact reports for all stakeholders.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- IT Services -->
  <section class="bg-slate-50">
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">TECHNOLOGY SOLUTIONS</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">CSR Technology Platform Services</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-desktop text-xl text-sky-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">CSR Program Management</h3>
          <p class="text-slate-600 text-sm">Custom-built platforms to manage, track, and optimize CSR initiatives.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-database text-xl text-teal-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Data Integration</h3>
          <p class="text-slate-600 text-sm">Integrate CSR platforms with existing business systems.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-arrows-spin text-xl text-emerald-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Digital Transformation</h3>
          <p class="text-slate-600 text-sm">Modernize operations and enhance competitiveness.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-sky-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-cloud text-xl text-sky-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Cloud Solutions</h3>
          <p class="text-slate-600 text-sm">Scalable cloud infrastructure and migration services.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-chart-line text-xl text-teal-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Data Analytics</h3>
          <p class="text-slate-600 text-sm">Business intelligence and predictive analytics solutions.</p>
        </div>
        <div class="bg-white p-5 rounded-xl border hover:-translate-y-1 transition-all">
          <div class="w-10 h-10 bg-emerald-100 rounded-lg flex items-center justify-center mb-3">
            <i class="fa-solid fa-shield-halved text-xl text-emerald-600"></i>
          </div>
          <h3 class="text-base font-semibold mb-2">Cybersecurity</h3>
          <p class="text-slate-600 text-sm">Protect digital assets and ensure business continuity.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Services -->
  <section>
    <div class="max-w-screen-2xl mx-auto px-6 py-8">
      <div class="text-center mb-6">
        <span class="text-sky-600 font-semibold text-sm">AI & INNOVATION</span>
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mt-1">AI-Powered Impact Communication</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-sky-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">🎬</div>
          <h3 class="text-base font-semibold mb-2">Impact Story Generation</h3>
          <p class="text-slate-600 text-sm">Transform CSR data into compelling visual stories.</p>
        </div>
        <div class="bg-gradient-to-br from-teal-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">✂️</div>
          <h3 class="text-base font-semibold mb-2">Stakeholder Videos</h3>
          <p class="text-slate-600 text-sm">Personalized video communications for different groups.</p>
        </div>
        <div class="bg-gradient-to-br from-emerald-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">🎯</div>
          <h3 class="text-base font-semibold mb-2">Video Marketing</h3>
          <p class="text-slate-600 text-sm">Targeted video content for specific audiences.</p>
        </div>
        <div class="bg-gradient-to-br from-violet-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">🎓</div>
          <h3 class="text-base font-semibold mb-2">Training Content</h3>
          <p class="text-slate-600 text-sm">AI-powered training materials and educational content.</p>
        </div>
        <div class="bg-gradient-to-br from-rose-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">📱</div>
          <h3 class="text-base font-semibold mb-2">Social Media</h3>
          <p class="text-slate-600 text-sm">Platform-optimized video content with auto-formatting.</p>
        </div>
        <div class="bg-gradient-to-br from-amber-50 to-white border p-5 rounded-xl hover:-translate-y-1 transition-all">
          <div class="text-2xl mb-2">📖</div>
          <h3 class="text-base font-semibold mb-2">Brand Storytelling</h3>
          <p class="text-slate-600 text-sm">Compelling narratives through AI-generated video.</p>
        </div>
      </div>

      <!-- AI Benefits -->
      <div class="mt-8 bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-8">
        <h3 class="text-xl font-semibold text-center mb-4">Benefits of AI Video Generation</h3>
        <div class="grid md:grid-cols-4 gap-4">
          <div class="text-center">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-2">
              <i class="fa-solid fa-bolt text-xl text-sky-400"></i>
            </div>
            <h4 class="font-semibold text-sm mb-1">Speed</h4>
            <p class="text-xs text-slate-300">10x faster than traditional methods</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-2">
              <i class="fa-solid fa-indian-rupee-sign text-xl text-teal-400"></i>
            </div>
            <h4 class="font-semibold text-sm mb-1">Cost-Effective</h4>
            <p class="text-xs text-slate-300">Reduce costs by up to 80%</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-2">
              <i class="fa-solid fa-palette text-xl text-emerald-400"></i>
            </div>
            <h4 class="font-semibold text-sm mb-1">Flexible</h4>
            <p class="text-xs text-slate-300">Unlimited creative possibilities</p>
          </div>
          <div class="text-center">
            <div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mx-auto mb-2">
              <i class="fa-solid fa-chart-bar text-xl text-violet-400"></i>
            </div>
            <h4 class="font-semibold text-sm mb-1">Data-Driven</h4>
            <p class="text-xs text-slate-300">Analytics-powered optimization</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
