---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dr. Hemant L. Patel | Founder & CEO | Causewave Innovations"
  description="Meet Dr. Hemant L. Patel — Founder of Causewave with 18+ years in public health leadership, WHO experience, and India's highest single-day vaccination innovation (33L+ doses)."
  ogTitle="Dr. Hemant L. Patel | Leadership | Causewave"
  ogDescription="18+ years transforming public health delivery in India. SKOCH Gold Award winner and founder of Causewave."
  canonicalPath="/founder"
  activePage="founder"
>
  <!-- Hero -->
  <div class="bg-slate-900 text-white py-20">
    <div class="max-w-screen-2xl mx-auto px-8">
      <h1 class="text-6xl font-semibold tracking-tight">Dr. Hemant L. Patel</h1>
      <p class="text-3xl text-sky-400 mt-2 font-medium">Founder & CEO</p>
    </div>
  </div>

  <!-- Bio -->
  <div class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="grid md:grid-cols-12 gap-16">
      <div class="md:col-span-8">
        <div class="prose prose-lg max-w-none text-slate-600 leading-relaxed space-y-6">
          <p class="text-xl">
            Dr. Hemant L. Patel is a public health leader with over 18 years of experience transforming healthcare delivery across India. His career spans frontline health program management, WHO collaborations, and large-scale vaccination innovations that have set national benchmarks.
          </p>
          <p>
            As the architect of India's highest single-day vaccination achievement — administering over 33 lakh (3.3 million) doses in a single day — Dr. Patel demonstrated what's possible when deep domain expertise meets operational excellence and community trust.
          </p>
          <p>
            His work has been recognized with the prestigious SKOCH Gold Award, one of India's highest civilian honors for governance and development impact. He has led health initiatives across multiple Indian states, working with government agencies, international organizations, and local communities.
          </p>
          <p>
            Through Causewave Innovations LLP, Dr. Patel brings this same rigor and field-tested approach to CSR consulting — helping corporations design, execute, and measure programs that deliver genuine, lasting impact for the communities they serve.
          </p>
        </div>
      </div>

      <div class="md:col-span-4">
        <div class="bg-slate-50 rounded-3xl p-10 sticky top-28">
          <h3 class="text-2xl font-semibold mb-6">Key Highlights</h3>
          <div class="space-y-6">
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Experience</div>
              <div class="mt-1 text-slate-700 font-medium">18+ Years in Public Health</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Signature Achievement</div>
              <div class="mt-1 text-slate-700 font-medium">33L+ Single-Day Vaccination Record</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Recognition</div>
              <div class="mt-1 text-slate-700 font-medium">SKOCH Gold Award</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Focus Areas</div>
              <div class="mt-1 text-slate-700 font-medium">CSR Strategy, Public Health, Community Impact</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Geography</div>
              <div class="mt-1 text-slate-700 font-medium">5+ States Across India</div>
            </div>
            <div>
              <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Organization</div>
              <div class="mt-1 text-slate-700 font-medium">Causewave Innovations LLP</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <section class="bg-slate-900 text-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-20 text-center">
      <h2 class="text-5xl font-semibold tracking-tight mb-6">Want to work with our team?</h2>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10">
        Dr. Patel and the Causewave team are ready to help your organization deliver CSR programs that are compliant, measurable, and genuinely trusted.
      </p>
      <a href="/contact" class="inline-flex px-8 py-4 bg-white text-slate-900 rounded-3xl font-semibold">Get in Touch</a>
    </div>
  </section>
</BaseLayout>
