---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About Us | Causewave Innovations LLP - CSR Consulting"
  description="Causewave bridges the gap between CSR compliance and real community impact. Learn how we help companies deliver measurable, trusted CSR programs across India."
  ogTitle="About Causewave | CSR Strategy & Impact"
  ogDescription="We help companies design, implement, and measure CSR initiatives that satisfy boards, regulators, and communities."
  canonicalPath="/about"
  activePage="about"
>
  <!-- Hero -->
  <div class="bg-slate-900 text-white py-20">
    <div class="max-w-screen-2xl mx-auto px-8">
      <h1 class="text-6xl font-semibold tracking-tight">Why Causewave Exists</h1>
      <p class="mt-4 text-xl text-slate-300 max-w-2xl">Most CSR programs struggle to be both compliant and truly impactful. We bridge that gap.</p>
    </div>
  </div>

  <!-- Mission -->
  <div class="max-w-screen-2xl mx-auto px-8 py-20">
    <div class="max-w-3xl text-xl text-slate-600 leading-relaxed space-y-6">
      <p>At Causewave, we help companies design, implement, and measure CSR initiatives that satisfy boards, regulators, and — most importantly — the communities they aim to serve.</p>
      <p>Our approach combines deep statutory knowledge with on-the-ground execution experience. We don't just write reports — we build programs that work in the real world.</p>
    </div>
  </div>

  <!-- What Sets Us Apart -->
  <section class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-20">
      <span class="text-sky-600 font-semibold">OUR APPROACH</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4 mb-16">What sets Causewave apart</h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl border bg-slate-50">
          <div class="w-14 h-14 bg-sky-100 rounded-2xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-shield-halved text-3xl text-sky-600"></i>
          </div>
          <h3 class="text-2xl font-semibold mb-3">Compliance-First Thinking</h3>
          <p class="text-slate-600">Every recommendation starts with statutory requirements and board expectations, ensuring your CSR program is audit-ready from day one.</p>
        </div>

        <div class="p-8 rounded-3xl border bg-slate-50">
          <div class="w-14 h-14 bg-teal-100 rounded-2xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-map-location-dot text-3xl text-teal-600"></i>
          </div>
          <h3 class="text-2xl font-semibold mb-3">Last-Mile Expertise</h3>
          <p class="text-slate-600">With 18+ years in public health delivery, we know what it takes to execute programs in India's most challenging environments.</p>
        </div>

        <div class="p-8 rounded-3xl border bg-slate-50">
          <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center mb-6">
            <i class="fa-solid fa-database text-3xl text-emerald-600"></i>
          </div>
          <h3 class="text-2xl font-semibold mb-3">Data-Driven Impact</h3>
          <p class="text-slate-600">We build M&E frameworks that produce credible, quantifiable evidence of impact — not just anecdotes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- By the Numbers -->
  <section>
    <div class="max-w-screen-2xl mx-auto px-8 py-20">
      <span class="text-sky-600 font-semibold">TRACK RECORD</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4 mb-16">Impact by the numbers</h2>

      <div class="grid md:grid-cols-4 gap-6">
        <div class="bg-white border p-10 rounded-3xl text-center">
          <div class="text-5xl font-bold text-sky-600 mb-3">18+</div>
          <div class="text-slate-600 font-medium">Years in Public Health</div>
        </div>
        <div class="bg-white border p-10 rounded-3xl text-center">
          <div class="text-5xl font-bold text-teal-600 mb-3">33L+</div>
          <div class="text-slate-600 font-medium">Single-Day Vaccination Record</div>
        </div>
        <div class="bg-white border p-10 rounded-3xl text-center">
          <div class="text-5xl font-bold text-emerald-600 mb-3">5+</div>
          <div class="text-slate-600 font-medium">States Covered</div>
        </div>
        <div class="bg-white border p-10 rounded-3xl text-center">
          <div class="text-5xl font-bold text-sky-600 mb-3">SKOCH</div>
          <div class="text-slate-600 font-medium">Gold Award</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Leadership -->
  <section id="leadership" class="bg-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-20">
      <span class="text-sky-600 font-semibold">LEADERSHIP</span>
      <h2 class="text-5xl font-semibold tracking-tight mt-4 mb-16">Meet Our Founder</h2>

      <div class="grid lg:grid-cols-12 gap-16 items-start">
        <div class="lg:col-span-8">
          <div class="prose prose-lg max-w-none text-slate-600 leading-relaxed space-y-6">
            <p class="text-xl">
              Dr. Hemant L. Patel is a public health leader with over 18 years of experience transforming healthcare delivery across India. His career spans frontline health program management, WHO collaborations, and large-scale vaccination innovations that have set national benchmarks.
            </p>
            <p>
              As the architect of India's highest single-day vaccination achievement — administering over 33 lakh (3.3 million) doses in a single day — Dr. Patel demonstrated what's possible when deep domain expertise meets operational excellence and community trust.
            </p>
            <p>
              His work has been recognized with the prestigious SKOCH Gold Award, one of India's highest civilian honors for governance and development impact. He has led health initiatives across multiple Indian states, working with government agencies, international organizations, and local communities.
            </p>
            <p>
              Through Causewave Innovations LLP, Dr. Patel brings this same rigor and field-tested approach to CSR consulting — helping corporations design, execute, and measure programs that deliver genuine, lasting impact for the communities they serve.
            </p>
          </div>
        </div>

        <div class="lg:col-span-4">
          <div class="bg-slate-50 rounded-3xl p-10 sticky top-28">
            <div class="w-20 h-20 bg-sky-600 text-white rounded-full flex items-center justify-center text-2xl font-bold mb-6">HP</div>
            <h3 class="text-2xl font-semibold mb-2">Dr. Hemant L. Patel</h3>
            <p class="text-slate-500 mb-6">Founder & CEO</p>
            <div class="space-y-5">
              <div>
                <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Experience</div>
                <div class="mt-1 text-slate-700 font-medium">18+ Years in Public Health</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Signature Achievement</div>
                <div class="mt-1 text-slate-700 font-medium">33L+ Single-Day Vaccination Record</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Recognition</div>
                <div class="mt-1 text-slate-700 font-medium">SKOCH Gold Award</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Focus Areas</div>
                <div class="mt-1 text-slate-700 font-medium">CSR Strategy, Public Health, Community Impact</div>
              </div>
              <div>
                <div class="text-sm font-semibold text-sky-600 uppercase tracking-wide">Geography</div>
                <div class="mt-1 text-slate-700 font-medium">5+ States Across India</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-slate-900 text-white">
    <div class="max-w-screen-2xl mx-auto px-8 py-20 text-center">
      <h2 class="text-5xl font-semibold tracking-tight mb-6">Let's build something meaningful together</h2>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10">
        Talk to our team about how Causewave can help your organization deliver CSR programs that are compliant, measurable, and genuinely trusted by communities.
      </p>
      <a href={`${base}contact`} class="inline-flex px-8 py-4 bg-white text-slate-900 rounded-3xl font-semibold">Start a Conversation</a>
    </div>
  </section>
</BaseLayout>
